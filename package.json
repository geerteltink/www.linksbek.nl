{
  "name": "www.linksbek.nl",
  "description": "Wie schrijft die blijft",
  "version": "1.0.15",
  "author": "Geert Eltink",
  "license": "MIT",
  "main": ".eleventy.js",
  "scripts": {
    "clean": "rm -rf _site && rm -rf .cache",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:md": "markdownlint -i src/style-guide.md src/**/*.md",
    "lint:css": "stylelint src/assets/**/*.css",
    "check-links": "npx check-html-links _site",
    "build": "npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8091",
    "serve-production": "NODE_ENV=production npx @11ty/eleventy --serve --port=8091",
    "build-production": "ELEVENTY_PRODUCTION=true NODE_ENV=production npx @11ty/eleventy",
    "format": "stylelint src/assets/**/*.css --fix"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "fast-glob": "^3.3.2",
    "html-minifier-terser": "^7.2.0",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdownlint": "^0.35.0",
    "markdownlint-cli": "^0.42.0",
    "md5": "^2.3.0",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "striptags": "^3.2.0",
    "stylelint": "^16.10.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended": "^14.0.1"
  }
}

{
  "name": "www.linksbek.nl",
  "description": "Wie schrijft die blijft",
  "version": "1.0.0",
  "author": "Geert Eltink",
  "license": "MIT",
  "main": ".eleventy.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:md": "markdownlint -i src/style-guide.md src/**/*.md",
    "lint:css": "stylelint src/assets/**/*.css",
    "check-links": "npx check-html-links _site",
    "build": "npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8091",
    "serve-production": "NODE_ENV=production npx @11ty/eleventy --serve --port=8091",
    "build-production": "NODE_ENV=production npx @11ty/eleventy",
    "format": "stylelint src/assets/**/*.css --fix"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-img": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "autoprefixer": "^10.4.11",
    "cssnano": "^5.1.13",
    "fast-glob": "^3.2.12",
    "html-minifier": "^4.0.0",
    "luxon": "^3.0.3",
    "markdown-it": "^13.0.1",
    "markdownlint": "^0.26.2",
    "markdownlint-cli": "^0.32.2",
    "md5": "^2.3.0",
    "postcss": "^8.4.16",
    "postcss-import": "^15.0.0",
    "striptags": "^3.2.0",
    "stylelint": "^14.13.0",
    "stylelint-config-recess-order": "^3.0.0",
    "stylelint-config-recommended": "^9.0.0"
  }
}

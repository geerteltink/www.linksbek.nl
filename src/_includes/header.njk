<header class="app-header navbar navbar-expand-lg navbar-light bg-light shadow-sm">
  <nav class="container">
    <a class="navbar-brand" href="/" aria-label="linksbek.nl">
      {% image "./src/images/logo-linksbek.gif", "logo linksbek.nl" %}
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      {% set navPages = collections.all | eleventyNavigation %}
      <ul class="navbar-nav mr-auto">
        {% for entry in navPages %}
          <li class="nav-item {% if entry.url == page.url %}active{% endif %}">
            <a class="nav-link" href="{{ entry.url | url }}">{{ entry.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>

{
  "name": "www.linksbek.nl",
  "description": "Wie schrijft die blijft",
  "version": "1.0.32",
  "author": "Geert Eltink",
  "license": "MIT",
  "main": ".eleventy.js",
  "scripts": {
    "clean": "rm -rf _site && rm -rf .cache",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:md": "markdownlint -i src/style-guide.md src/**/*.md",
    "lint:css": "stylelint src/assets/**/*.css",
    "build": "npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8091",
    "serve-production": "NODE_ENV=production npx @11ty/eleventy --serve --port=8091",
    "build-production": "ELEVENTY_PRODUCTION=true NODE_ENV=production npx @11ty/eleventy",
    "format": "stylelint src/assets/**/*.css --fix",
    "compress-images": "mogrify -quality \"75%\" -resize 1024x1024\\> src/images/*.*"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.0",
    "markdownlint": "^0.39.0",
    "markdownlint-cli": "^0.45.0",
    "md5": "^2.3.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "striptags": "^3.2.0",
    "stylelint": "^16.25.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-order": "^7.0.0"
  },
  "dependencies": {
    "markdown-it-footnote": "^4.0.0"
  }
}

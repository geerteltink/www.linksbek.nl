{
  "name": "www.linksbek.nl",
  "description": "Wie schrijft die blijft",
  "version": "1.0.0",
  "author": "Geert Eltink",
  "license": "MIT",
  "main": ".eleventy.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:md": "markdownlint src/**/*.md",
    "lint:css": "stylelint {assets,content,layouts}/**/*.{css,scss}",
    "lint:fix": "stylelint {assets,content,layouts}/**/*.{css,scss} --fix",
    "check-links": "npx check-html-links _site",
    "build": "npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8091",
    "serve-production": "NODE_ENV=production npx @11ty/eleventy --serve --port=8091",
    "build-production": "NODE_ENV=production npx @11ty/eleventy",
    "format": "prettier --write '**/*.{js,css,html,md}'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.1",
    "@11ty/eleventy-img": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.3",
    "autoprefixer": "^10.4.7",
    "bootstrap": "^5.1.3",
    "luxon": "^2.4.0",
    "markdown-it": "^13.0.1",
    "markdownlint": "^0.26.0",
    "markdownlint-cli": "^0.31.1",
    "postcss": "^8.4.14",
    "postcss-cli": "^10.0.0",
    "striptags": "^3.2.0",
    "stylelint": "^14.9.1",
    "stylelint-config-idiomatic-order": "^8.1.0",
    "stylelint-config-recess-order": "^3.0.0",
    "stylelint-config-recommended-scss": "^6.0.0",
    "stylelint-config-standard": "^26.0.0",
    "stylelint-order": "^5.0.0",
    "stylelint-scss": "^4.2.0"
  }
}
